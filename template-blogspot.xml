        <a href='https://instagram.com' target='_blank' class='insta-btn'>
          <i class='fab fa-instagram'></i>
          <span>@your.instagram</span>
        </a>
      </div>
      <div class='couple-separator'>
        <span class='font-combo'>&amp;</span>
      </div>
      <div class='couple-card groom-card'>
        <div class='couple-image-wrapper'>
          <img src='https://i.imgur.com/groom-photo.jpg' alt='Fredy Bastian Nugroho' class='couple-photo'/>
