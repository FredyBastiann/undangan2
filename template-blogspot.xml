<style type='text/css'>
/* <![CDATA[ */
*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:'Poppins',sans-serif;font-weight:400;color:#7A7A7A;background-color:#fafafa;overflow-x:hidden}
/* FONTS */
.font-heading-script{font-family:'Pinyon Script',serif;font-weight:600}
.font-islamic{font-family:'Cormorant Infant',serif;font-style:italic}
.font-combo{font-family:'Combo',cursive}
/* ANIMATIONS */
@keyframes fadeInUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeInDown{from{opacity:0;transform:translateY(-30px)}to{opacity:1;transform:translateY(0)}}
@keyframes zoomIn{from{opacity:0;transform:scale(0.8)}to{opacity:1;transform:scale(1)}}
@keyframes fadeInLeft{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:translateX(0)}}
.animated-slow{animation-duration:1s;animation-fill-mode:both}
.elementor-invisible{visibility:hidden}
/* HERO */
.hero-section{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f5f0eb 0%,#e8e0d8 50%,#f0ebe6 100%);padding:40px 20px}
.hero-container{display:flex;max-width:1400px;width:100%;gap:0;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.1)}
.hero-left{flex:1;display:flex;align-items:center;justify-content:center;padding:60px 50px;min-height:500px;background:linear-gradient(180deg,#fff 0%,#faf7f4 100%)}
.hero-content{text-align:center;max-width:450px}
.hero-content h2.font-heading-script{font-size:2.2rem;color:#6EC1E4;margin-bottom:10px}
.hero-content h1.font-heading-script{font-size:3.5rem;color:#333;margin-bottom:25px;line-height:1.2}
.quote-text{font-family:'Cormorant Infant',serif;font-style:italic;font-size:1.1rem;color:#54595F;line-height:1.8;margin-bottom:30px}
.guest-label{font-family:'Poppins',sans-serif;font-size:1rem;color:#7A7A7A;margin-bottom:5px}
.guest-label-highlight{font-family:'Combo',cursive;font-size:1.8rem;color:#6EC1E4;margin-bottom:10px}
.hero-right{flex:1;position:relative;min-height:500px}
.hero-image{width:100%;height:100%;background-size:cover;background-position:center;background-repeat:no-repeat;position:relative;display:flex;align-items:center;justify-content:center}
.hero-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.3)}
.hero-text-content{position:relative;z-index:2;text-align:center;color:#fff;padding:40px}
.hero-text-content h2.font-heading-script{font-size:2rem;margin-bottom:10px}
.hero-text-content h1.font-heading-script{font-size:3rem;margin-bottom:15px}
.date-text{font-size:1.8rem;color:#FFBC7D}
/* LOWER SECTION */
.lower-section{padding:80px 20px;background:#fff}
.lower-container{max-width:1100px;margin:0 auto;text-align:center}
.letters-row{display:flex;justify-content:center;gap:30px;margin-bottom:40px}
.letter-box{width:150px;height:150px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(135deg,#6EC1E4,#61CE70);box-shadow:0 10px 30px rgba(110,193,228,.3)}
.letter-box h1.font-combo{font-size:6rem;color:#fff}
.quran-text{max-width:800px;margin:0 auto}
.quran-text h2{font-family:'Cormorant Infant',serif;font-style:italic;font-size:1.4rem;color:#54595F;line-height:1.8;margin-bottom:15px}
.quran-ref{font-family:'Poppins',sans-serif;font-size:1.1rem;color:#6EC1E4;font-weight:600}
/* BRIDE & GROOM */
.bride-groom-section{padding:80px 20px;position:relative;background:linear-gradient(180deg,#fafafa 0%,#f0ebe6 100%);overflow:hidden}
.container{max-width:1140px;margin:0 auto;position:relative}
.section-label{text-align:center;margin-bottom:20px}
.section-label span{font-family:'Pinyon Script',serif;font-size:2.5rem;color:#333}
.bismillah-text{text-align:center;margin-bottom:20px}
.bismillah-text span.font-combo{font-size:1.8rem;color:#6EC1E4}
.desc-text{text-align:center;font-family:'Poppins',sans-serif;font-size:1rem;color:#7A7A7A;margin-bottom:50px;max-width:700px;margin-left:auto;margin-right:auto}
.couple-container{display:flex;justify-content:center;align-items:flex-start;gap:60px;flex-wrap:wrap}
.couple-card{text-align:center;background:#fff;border-radius:20px;padding:40px 30px;box-shadow:0 10px 40px rgba(0,0,0,.08);width:300px;transition:transform .3s ease,box-shadow .3s ease}
.couple-card:hover{transform:translateY(-10px);box-shadow:0 20px 60px rgba(0,0,0,.12)}
.couple-image-wrapper{width:180px;height:180px;border-radius:50%;overflow:hidden;margin:0 auto 25px;border:4px solid #6EC1E4;box-shadow:0 5px 15px rgba(110,193,228,.3)}
.couple-photo{width:100%;height:100%;object-fit:cover}
.couple-name{font-family:'Pinyon Script',serif;font-size:2.2rem;color:#333;margin-bottom:10px}
.couple-parents{font-family:'Poppins',sans-serif;font-size:.9rem;color:#7A7A7A;line-height:1.6;margin-bottom:20px}
.insta-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#fff;padding:10px 25px;border-radius:50px;text-decoration:none;font-family:'Poppins',sans-serif;font-size:.9rem;font-weight:500;transition:transform .3s ease}
.insta-btn:hover{transform:scale(1.05)}
.couple-separator{display:flex;align-items:center;justify-content:center;margin-top:80px}
.couple-separator span.font-combo{font-size:4rem;color:#6EC1E4}
/* COUNTDOWN */
.countdown-section{padding:80px 20px;background:#fff}
.countdown-label{text-align:center;margin-bottom:50px}
.countdown-label span{font-family:'Pinyon Script',serif;font-size:2.5rem;color:#333}
.countdown-timer{display:flex;justify-content:center;gap:20px;flex-wrap:wrap}
.countdown-box{background:linear-gradient(135deg,#6EC1E4,#4a9fd4);border-radius:15px;padding:30px 25px;min-width:120px;text-align:center;box-shadow:0 10px 30px rgba(110,193,228,.3);color:#fff}
.count-number{display:block;font-family:'Poppins',sans-serif;font-size:3rem;font-weight:700;line-height:1;margin-bottom:5px}
.count-label{font-family:'Poppins',sans-serif;font-size:.9rem;text-transform:uppercase;letter-spacing:2px;opacity:.9}
/* WEDDING EVENT */
.wedding-event-section{padding:80px 20px}
.wedding-event-grid{display:flex;gap:0;max-width:1140px;margin:0 auto}
.wedding-event-col{flex:1;padding:40px;background:#fff}
.wedding-event-col:first-child{border-right:1px solid #e0d8d0}
.event-title{font-family:'Pinyon Script',serif;font-size:2rem;color:#333;margin-bottom:10px;text-align:center}
.event-date{font-family:'Poppins',sans-serif;font-size:1.5rem;color:#6EC1E4;margin-bottom:5px}
.event-time{font-family:'Poppins',sans-serif;font-size:1.2rem;color:#54595F;margin-bottom:15px}
.event-location{font-family:'Poppins',sans-serif;font-size:1rem;color:#7A7A7A;line-height:1.6;margin-bottom:15px}
.event-map-icon{color:#6EC1E4;font-size:1.5rem;margin-bottom:15px}
.event-btn{display:inline-block;background:linear-gradient(135deg,#6EC1E4,#61CE70);color:#fff;padding:10px 30px;border-radius:50px;text-decoration:none;font-family:'Poppins',sans-serif;font-size:1rem;font-weight:500;transition:transform .3s ease}
.event-btn:hover{transform:translateY(-3px);box-shadow:0 10px 25px rgba(110,193,228,.4)}
/* LOVE STORY */
.love-story-section{padding:80px 20px;background:#fafafa}
.love-story-container{max-width:1140px;margin:0 auto}
.love-story-title{font-family:'Pinyon Script',serif;font-size:2.5rem;color:#333;text-align:center;margin-bottom:10px}
.love-story-item{padding:30px;background:#fff;border-radius:15px;margin-bottom:20px;box-shadow:0 5px 15px rgba(0,0,0,.05)}
.love-story-date{font-family:'Pinyon Script',serif;font-size:1.5rem;color:#6EC1E4;margin-bottom:10px}
.love-story-quote{font-family:'Cormorant Infant',serif;font-style:italic;font-size:1.2rem;color:#54595F;line-height:1.8}
/* WEDDING GIFT */
.wedding-gift-section{padding:80px 20px;background:#fff}
.wedding-gift-container{max-width:1140px;margin:0 auto;text-align:center}
.wedding-gift-title{font-family:'Pinyon Script',serif;font-size:2.5rem;color:#333;margin-bottom:10px}
.wedding-gift-desc{font-family:'Poppins',sans-serif;font-size:1rem;color:#7A7A7A;margin-bottom:30px;max-width:700px;margin-left:auto;margin-right:auto}
.gift-grid{display:flex;gap:30px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}
.gift-card{background:#fafafa;border-radius:15px;padding:30px;min-width:280px;max-width:350px;box-shadow:0 5px 15px rgba(0,0,0,.05)}
.gift-bank-logo{width:120px;height:60px;background:#e0e0e0;border-radius:8px;margin:0 auto 15px;display:flex;align-items:center;justify-content:center;font-family:'Poppins',sans-serif;font-weight:600;color:#666;font-size:.9rem}
.gift-account-name{font-family:'Pinyon Script',serif;font-size:1.5rem;color:#6EC1E4;margin-bottom:5px}
.gift-account-number{font-family:'Poppins',sans-serif;font-size:1.1rem;color:#333;cursor:pointer;padding:8px 15px;border:1px dashed #6EC1E4;border-radius:8px;display:inline-block;margin:10px 0;transition:background .3s ease}
.gift-account-number:hover{background:#6EC1E4;color:#fff}
.gift-copy-btn{display:inline-block;background:linear-gradient(135deg,#6EC1E4,#61CE70);color:#fff;padding:8px 20px;border-radius:50px;text-decoration:none;font-family:'Poppins',sans-serif;font-size:.9rem;font-weight:500;transition:transform .3s ease}
.gift-copy-btn:hover{transform:scale(1.05)}
.gift-wa-btn{display:inline-block;background:#25D366;color:#fff;padding:8px 20px;border-radius:50px;text-decoration:none;font-family:'Poppins',sans-serif;font-size:.9rem;font-weight:500;margin-left:10px;transition:transform .3s ease}
.gift-wa-btn:hover{transform:scale(1.05)}
/* DOA & UCAPAN */
.doa-section{padding:80px 20px;background:linear-gradient(180deg,#f0ebe6 0%,#e8e0d8 100%)}
.doa-container{max-width:1140px;margin:0 auto;text-align:center}
.doa-title{font-family:'Pinyon Script',serif;font-size:2.5rem;color:#333;margin-bottom:30px}
.doa-form{max-width:600px;margin:0 auto;display:flex;flex-direction:column;gap:15px}
.doa-input,.doa-textarea,.doa-select{width:100%;padding:15px 20px;border:2px solid #e0d8d0;border-radius:12px;font-family:'Poppins',sans-serif;font-size:1rem;color:#333;background:#fff;transition:border-color .3s ease;outline:none}
.doa-input:focus,.doa-textarea:focus,.doa-select:focus{border-color:#6EC1E4}
.doa-textarea{height:120px;resize:vertical}
.doa-btn{background:linear-gradient(135deg,#6EC1E4,#61CE70);color:#fff;border:none;padding:15px 40px;border-radius:50px;font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:600;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;margin-top:10px}
.doa-btn:hover{transform:translateY(-3px);box-shadow:0 10px 25px rgba(110,193,228,.4)}
/* COVER MODAL */
.cover-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background-size:cover;background-position:center;background-repeat:no-repeat;z-index:99999;display:flex;align-items:center;justify-content:center;transition:opacity .6s ease}
.cover-overlay.closed{opacity:0;pointer-events:none}
.cover-content{text-align:center;color:#fff;background:rgba(0,0,0,.5);padding:60px;border-radius:20px;max-width:500px;width:90%}
.cover-wedding{font-family:'Pinyon Script',serif;font-size:2rem;margin-bottom:10px}
.cover-name{font-family:'Combo',cursive;font-size:2.5rem;color:#FFBC7D;margin-bottom:20px}
.cover-dear{font-family:'Poppins',sans-serif;font-size:1rem;color:#fff;margin-bottom:10px}
.cover-guest-name{font-family:'Pinyon Script',serif;font-size:1.5rem;color:#6EC1E4;margin-bottom:30px}
.cover-btn{display:inline-block;background:linear-gradient(135deg,#6EC1E4,#61CE70);color:#fff;padding:15px 40px;border-radius:50px;text-decoration:none;font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:600;transition:transform .3s ease}
.cover-btn:hover{transform:scale(1.05)}
/* AUDIO PLAYER */
.audio-player{position:fixed;bottom:20px;right:20px;z-index:10000}
.audio-box{display:flex;gap:10px;align-items:center}
.audio-icon{width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#6EC1E4,#61CE70);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.5rem;cursor:pointer;transition:transform .3s ease}
.audio-icon:hover{transform:scale(1.1)}
/* FOOTER */
.site-footer{padding:40px 20px;background:#333;text-align:center}
.social-links{display:flex;justify-content:center;gap:20px;margin-bottom:20px}
.social-link{display:flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;text-decoration:none;font-size:1.3rem;transition:background .3s ease,transform .3s ease}
.social-link:hover{background:#6EC1E4;transform:translateY(-3px)}
.footer-text{font-family:'Poppins',sans-serif;font-size:.8rem;color:#999}
/* RESPONSIVE */
@media only screen and (max-width:1024px){
.hero-container{flex-direction:column}
.hero-left,.hero-right{width:100%;min-height:auto}
.hero-left{padding:40px 30px}
.hero-content h1.font-heading-script{font-size:2.5rem}
.couple-container{flex-direction:column;align-items:center}
.couple-separator{margin-top:20px;margin-bottom:20px}
.wedding-event-grid{flex-direction:column}
.wedding-event-col:first-child{border-right:none;border-bottom:1px solid #e0d8d0}
.gift-grid{flex-direction:column;align-items:center}
}
@media only screen and (max-width:767px){
.hero-content h2.font-heading-script{font-size:1.8rem}
.hero-content h1.font-heading-script{font-size:2rem}
.hero-text-content h1.font-heading-script{font-size:2rem}
.hero-text-content h2.font-heading-script{font-size:1.5rem}
.date-text{font-size:1.4rem}
.letter-box{width:100px;height:100px}
.letter-box h1.font-combo{font-size:4rem}
.countdown-box{min-width:80px;padding:20px 15px}
.count-number{font-size:2rem}
.couple-card{width:100%;max-width:300px}
.bismillah-text span.font-combo{font-size:1.3rem}
}
@media only screen and (max-width:480px){
.countdown-timer{gap:10px}
.countdown-box{min-width:70px;padding:15px 10px}
.count-number{font-size:1.5rem}
}
/* ]]> */
</style>

